# Matches what the tree already does, so an editor that reads this file agrees with the
# diffs rather than reformatting around them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.kt]
max_line_length = 100
ij_kotlin_imports_layout = *
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

# Gradle build scripts in this project are two-space.
[*.{kts,gradle}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[gradlew]
end_of_line = lf

[*.bat]
end_of_line = crlf
