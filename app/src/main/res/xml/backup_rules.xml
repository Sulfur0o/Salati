<?xml version="1.0" encoding="utf-8"?>
<!--
  API 30 and below, where one set of rules governs both cloud backup and a direct
  device-to-device transfer. Same policy as data_extraction_rules.xml: the settings store
  and nothing else.

  An <include> here is exclusive - naming one path opts every other file out - so this
  says "back up exactly this", not "back up this as well".
-->
<full-backup-content>
    <include domain="file" path="datastore/salati_settings.preferences_pb" />
</full-backup-content>
