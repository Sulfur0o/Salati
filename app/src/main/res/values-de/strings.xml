    <string name="battery_opt_oppo_title">Oppo / Realme / OnePlus</string>
    <string name="battery_opt_oppo_desc">Aktiviere „Hintergrundaktivität zulassen“ und „Automatischen Start zulassen“ in der Akkuverwaltung der App.</string>
