    <!-- Battery Optimization Help -->
    <string name="battery_opt_title">Notification Reliability</string>
    <string name="battery_opt_desc">If notifications are delayed or silenced, your device\'s battery saver may be restricting background alarms. Disabling battery optimization ensures on-time prayer alerts.</string>
    <string name="battery_opt_btn_open">Open Battery Settings</string>
    <string name="battery_opt_oem_title">Manufacturer Specific Advice</string>
    <string name="battery_opt_device_detected">Instructions for your %1$s</string>
    <string name="battery_opt_xiaomi_title">Xiaomi / MIUI / HyperOS</string>
    <string name="battery_opt_xiaomi_desc">Enable \'Autostart\', set Battery Saver to \'No restrictions\', and lock Salati in the Recent Apps tray.</string>
    <string name="battery_opt_samsung_title">Samsung / One UI</string>
    <string name="battery_opt_samsung_desc">Go to Battery -&gt; Background usage limits -&gt; Exclude Salati from \'Sleeping apps\' and \'Deep sleeping apps\'.</string>
    <string name="battery_opt_oppo_title">Oppo / Realme / OnePlus</string>
    <string name="battery_opt_oppo_desc">Enable \'Allow background activity\' and \'Allow auto-launch\' in App Battery Management.</string>
    <string name="battery_opt_huawei_title">Huawei / EMUI</string>
    <string name="battery_opt_huawei_desc">Go to Settings -&gt; Battery -&gt; App launch -&gt; Set Salati to \'Manage manually\' (enable Auto-launch &amp; Run in background).</string>
    <string name="battery_opt_generic_title">Google Pixel / Other Android</string>
    <string name="battery_opt_generic_desc">Go to Settings -&gt; Apps -&gt; Salati -&gt; Battery -&gt; Choose \'Unrestricted\' to ensure alarms fire reliably.</string>
