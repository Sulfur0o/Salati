<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Starting-window appearance only; once the Activity is up, MainActivity drives the
        system bars through enableEdgeToEdge so they follow the in-app theme override too.
        windowLightNavigationBar is API 27+ and is simply ignored on 24-26.
    -->
    <style name="Theme.Salati" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
